<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPageBg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="40dp">

        <!-- 顶栏：标题 + 三个图标按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:text="课表组件"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="桌面课表"
                    android:textColor="?attr/colorTextTertiary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="刷新组件"
                android:padding="10dp"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/btn_style"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="编辑样式"
                android:padding="10dp"
                android:src="@drawable/ic_tune" />

            <ImageView
                android:id="@+id/btn_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_icon_btn"
                android:contentDescription="更多"
                android:padding="10dp"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <!-- 今日概要卡：一句话说清「今天几节课、下一节是什么」 -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_6"
            android:background="@drawable/bg_surface"
            android:orientation="vertical"
            android:padding="@dimen/sp_5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="今天 · 11月10日 周二"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/hero_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/tag_on"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="进行中"
                    android:textColor="?attr/colorAccent"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="-0.01"
                android:text="今天没有课"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hero_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="导入课表后，这里显示今天的安排"
                android:textColor="?attr/colorTextTertiary"
                android:textSize="13sp" />

            <!-- 无数据时才出现的主操作 -->
            <LinearLayout
                android:id="@+id/hero_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sp_4"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_pick"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:gravity="center"
                    android:text="导入 .ics 文件"
                    android:textColor="#FF04120E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_pair"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:text="输入配对码"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 空态引导：第一次用的人不知道组件要自己去桌面加 -->
        <LinearLayout
            android:id="@+id/onboarding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_3"
            android:background="@drawable/bg_surface_soft"
            android:orientation="vertical"
            android:padding="@dimen/sp_4"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="怎么加到桌面"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="6dp"
                android:text="1&#160;&#160;&#160;长按桌面空白处，选「小组件」"
                android:textColor="?attr/colorTextTertiary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2&#160;&#160;&#160;找到「课表组件」，拖到桌面"
                android:textColor="?attr/colorTextTertiary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="3&#160;&#160;&#160;回到这里导入课表，桌面自动更新"
                android:textColor="?attr/colorTextTertiary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 时间线 -->
        <TextView
            android:id="@+id/list_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sp_6"
            android:layout_marginBottom="@dimen/sp_2"
            android:letterSpacing="0.06"
            android:text="日程"
            android:textColor="?attr/colorTextTertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
