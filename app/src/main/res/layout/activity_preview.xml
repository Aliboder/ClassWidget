<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- ── 固定区：标题 + 实时预览（滚设置时也一直看得见） ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.02"
                android:text="编辑样式"
                android:textColor="@color/text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_dirty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_on"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="未保存"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_reset"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:text="重置"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/preview_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/preview_stage"
            android:layout_marginTop="10dp"
            android:padding="@dimen/sp_2">

            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- ── 可滚动区：各项设置 ── -->
    <ScrollView
        android:id="@+id/editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        android:paddingTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView style="@style/EditorSection" android:layout_marginTop="14dp" android:text="强调色" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/sp_3">

                <LinearLayout
                    android:id="@+id/accent_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <TextView style="@style/EditorSection" android:layout_marginTop="14dp" android:text="外观" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_3"
                android:paddingEnd="@dimen/sp_3"
                android:paddingTop="@dimen/sp_1"
                android:paddingBottom="@dimen/sp_1">

                <include layout="@layout/row_slider" android:id="@+id/row_alpha" />
                <include layout="@layout/row_slider" android:id="@+id/row_card_alpha" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="背景圆角"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/r_root_0" style="@style/EditorChip" android:text="直角" />
                    <TextView android:id="@+id/r_root_1" style="@style/EditorChip" android:text="小" />
                    <TextView android:id="@+id/r_root_2" style="@style/EditorChip" android:text="中" />
                    <TextView android:id="@+id/r_root_3" style="@style/EditorChip" android:text="大" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="卡片圆角"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/r_card_0" style="@style/EditorChip" android:text="直角" />
                    <TextView android:id="@+id/r_card_1" style="@style/EditorChip" android:text="小" />
                    <TextView android:id="@+id/r_card_2" style="@style/EditorChip" android:text="中" />
                    <TextView android:id="@+id/r_card_3" style="@style/EditorChip" android:text="大" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/EditorSection" android:layout_marginTop="14dp" android:text="排版" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:paddingStart="@dimen/sp_3"
                android:paddingEnd="@dimen/sp_3"
                android:paddingTop="@dimen/sp_1"
                android:paddingBottom="@dimen/sp_2">

                <include layout="@layout/row_slider" android:id="@+id/row_font" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="卡片高度"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/h_auto" style="@style/EditorChip" android:text="自动" />
                    <TextView android:id="@+id/h_min" style="@style/EditorChip" android:text="紧凑" />
                    <TextView android:id="@+id/h_mid" style="@style/EditorChip" android:text="标准" />
                    <TextView android:id="@+id/h_max" style="@style/EditorChip" android:text="宽松" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/EditorSection" android:layout_marginTop="14dp" android:text="内容" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/sp_3">

                <TextView android:id="@+id/chk_upcoming" style="@style/EditorSwitch" android:text="显示未来课程" />
                <TextView android:id="@+id/chk_place" style="@style/EditorSwitch" android:text="显示地点" />
                <TextView android:id="@+id/chk_teacher" style="@style/EditorSwitch" android:text="显示教师" />
                <TextView android:id="@+id/chk_kind" style="@style/EditorSwitch" android:text="显示类型标签" />

            </LinearLayout>

            <TextView style="@style/EditorSection" android:layout_marginTop="14dp" android:text="主题" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/sp_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/theme_auto" style="@style/EditorChip" android:text="跟随系统" />
                    <TextView android:id="@+id/theme_light" style="@style/EditorChip" android:text="浅色" />
                    <TextView android:id="@+id/theme_dark" style="@style/EditorChip" android:text="深色" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="切换后界面立即生效；桌面组件需重新添加才会完全跟上"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView style="@style/EditorSection" android:layout_marginTop="14dp" android:text="行为" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_surface"
                android:orientation="vertical"
                android:padding="@dimen/sp_3">
                <TextView
                    android:id="@+id/chk_click"
                    style="@style/EditorSwitch"
                    android:layout_marginTop="6dp"
                    android:text="点击组件打开软件" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ── 固定底部：保存 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/gutter"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:lineSpacingExtra="2dp"
            android:text="卡片高度、圆角这类属性需要重新添加组件才完全生效"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="保存"
            android:textColor="#FF04120E"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
