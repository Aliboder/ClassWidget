<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0C10"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="样式编辑"
            android:textColor="#FFF2F5F8"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/preview_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="#FF6B7480"
            android:textSize="12sp" />

        <!-- 预览舞台 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/preview_stage"
            android:padding="14dp">

            <FrameLayout
                android:id="@+id/preview_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- 快捷预设 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="快捷预设"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
                <TextView
                    android:id="@+id/btn_preset_default"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="默认"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/btn_preset_glass"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="玻璃"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/btn_preset_min"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="极简"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/btn_preset_contrast"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="高对比"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 外观 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="外观"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="背景透明度"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_alpha"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="100"
                    android:progress="93" />

                <TextView
                    android:id="@+id/txt_alpha"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="卡片透明度"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_alpha_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="100"
                    android:progress="90" />

                <TextView
                    android:id="@+id/txt_alpha_card"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="背景圆角"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_radius_root"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="40"
                    android:progress="24" />

                <TextView
                    android:id="@+id/txt_radius_root"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="卡片圆角"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_radius"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="40"
                    android:progress="16" />

                <TextView
                    android:id="@+id/txt_radius"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 排版 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="排版"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="字号"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_font"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="80"
                    android:progress="30" />

                <TextView
                    android:id="@+id/txt_font"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="卡片高度"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_card_h"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="51"
                    android:progress="0" />

                <TextView
                    android:id="@+id/txt_card_h"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 显示 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="显示内容"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <CheckBox
                android:id="@+id/chk_upcoming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#FF3FD3AC"
                android:text="显示未来课程（关闭则只看今天）"
                android:textColor="#FFD5DAE1"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#14FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chk_place"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FF3FD3AC"
                android:text="地点"
                android:textColor="#FFD5DAE1"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/chk_teacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="#FF3FD3AC"
                android:text="教师"
                android:textColor="#FFD5DAE1"
                android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 刷新频率 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="刷新频率"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_refresh_smart"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="智能"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/btn_refresh_saver"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="省电"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/btn_refresh_frequent"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="频繁"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_refresh_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#FF5A626C"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 点击行为 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="点击组件"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp">

            <CheckBox
                android:id="@+id/chk_click"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#FF3FD3AC"
                android:text="点击组件打开软件"
                android:textColor="#FFD5DAE1"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 预览尺寸 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="预览尺寸（只影响本页）"
            android:textColor="#FF6B7480"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_group"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="宽"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_w"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="480"
                    android:progress="200" />

                <TextView
                    android:id="@+id/txt_w"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="7dp"
                android:paddingBottom="7dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="高"
                    android:textColor="#FFA8B2BC"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seek_h"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.2"
                    android:max="380"
                    android:progress="78" />

                <TextView
                    android:id="@+id/txt_h"
                    android:layout_width="62dp"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:textColor="#FF3FD3AC"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
                <TextView
                    android:id="@+id/btn_2x2"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="2×2"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/btn_4x2"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="4×2"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/btn_4x4"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="4×4"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
                <TextView
                    android:id="@+id/btn_tablet"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="平板"
                    android:textColor="#FFB8BFCB"
                    android:textSize="12.5sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chk_sample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:buttonTint="#FF3FD3AC"
            android:text="用示例数据预览"
            android:textColor="#FFB8BFCB"
            android:textSize="12.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:text="改动即时生效，桌面上的组件会同步刷新。预览高度与桌面实际可能差 10~20dp（各家桌面格子高度不同）。"
            android:textColor="#FF5A626C"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_reset"
            android:gravity="center"
            android:text="恢复默认样式"
            android:textColor="#FFB8BFCB"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
